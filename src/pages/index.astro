---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CTABanner from '../components/CTABanner.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const featured = allArticles.filter(a => a.data.featured);
const recent = [...allArticles].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 6);

function articleHref(article: any) {
  const slug = article.id.split('/').pop()!.replace(/\.md$/, '');
  return `/${article.data.category}/${slug}`;
}
---

<Base title="The New Manager Hub" description="Practical advice, book recommendations, and tools for first-time people managers. No fluff — just what works.">

  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-20 sm:py-28 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-stone-900 leading-tight mb-6" style="font-family: var(--font-serif);">
        Your first management role?<br />
        <span class="text-brand-600">We've got you.</span>
      </h1>
      <p class="text-lg sm:text-xl text-stone-600 max-w-2xl mx-auto mb-8 leading-relaxed">
        Curated books, courses, tools, and real-world advice for new managers — from someone who's been there. No corporate jargon. No guru nonsense. Just what actually works.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/books" class="bg-brand-600 hover:bg-brand-700 text-white font-medium px-8 py-3.5 rounded-lg transition-colors text-lg">
          Browse Top Books
        </a>
        <a href="/advice" class="bg-white hover:bg-stone-50 text-stone-700 font-medium px-8 py-3.5 rounded-lg border border-stone-300 transition-colors text-lg">
          Read Our Guides
        </a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 -mt-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {[
        { emoji: '📚', label: 'Books', desc: 'Best reads for new managers', href: '/books' },
        { emoji: '🎓', label: 'Courses', desc: 'Online learning that works', href: '/courses' },
        { emoji: '🛠️', label: 'Tools', desc: 'Software to make life easier', href: '/tools' },
        { emoji: '💡', label: 'Advice', desc: 'Real-world guides & tips', href: '/advice' },
      ].map(cat => (
        <a href={cat.href} class="bg-white border border-stone-200 rounded-xl p-5 hover:border-brand-300 hover:shadow-md transition-all group text-center">
          <span class="text-3xl block mb-2">{cat.emoji}</span>
          <p class="font-bold text-stone-900 group-hover:text-brand-600 transition-colors">{cat.label}</p>
          <p class="text-xs text-stone-500 mt-1">{cat.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured articles -->
  {featured.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-stone-900 mb-8" style="font-family: var(--font-serif);">
        Start Here
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {featured.map(article => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            href={articleHref(article)}
            category={article.data.category}
            date={article.data.date}
            featured
          />
        ))}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-16">
    <CTABanner
      heading="Not sure where to start?"
      text="Our survival guide walks you through your first week as a manager, day by day."
      buttonText="Read the Guide"
      buttonUrl="/advice/first-week-as-manager"
    />
  </section>

  <!-- Latest articles -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-20">
    <h2 class="text-2xl sm:text-3xl font-bold text-stone-900 mb-8" style="font-family: var(--font-serif);">
      Latest Articles
    </h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {recent.map(article => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          href={articleHref(article)}
          category={article.data.category}
          date={article.data.date}
        />
      ))}
    </div>
  </section>

</Base>

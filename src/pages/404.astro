---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found">
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <h1 class="text-6xl font-bold text-brand-600 mb-4" style="font-family: var(--font-serif);">404</h1>
    <p class="text-xl text-stone-600 mb-8">This page doesn't exist — but we've got plenty that do.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 px-5 py-2.5 rounded-lg transition-colors">
        Go Home
      </a>
      <a href="/books" class="inline-flex items-center gap-2 text-sm font-medium text-brand-600 border border-brand-300 hover:bg-brand-50 px-5 py-2.5 rounded-lg transition-colors">
        Browse Books
      </a>
      <a href="/advice" class="inline-flex items-center gap-2 text-sm font-medium text-brand-600 border border-brand-300 hover:bg-brand-50 px-5 py-2.5 rounded-lg transition-colors">
        Read Advice
      </a>
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const today = new Date().toISOString().slice(0, 10);
const articles = (await getCollection('articles'))
  .filter(a => a.data.category === 'tools' && a.data.date <= today)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function articleHref(article: any) {
  const slug = article.id.split('/').pop()!.replace(/\.md$/, '');
  return `/tools/${slug}`;
}
---

<Base title="Best Tools for New Managers" description="Software and tools that make managing a team easier. Honest reviews and comparisons.">
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 mb-3" style="font-family: var(--font-serif);">🛠️ Tools</h1>
    <p class="text-lg text-stone-500 mb-10">Software that makes the management job less chaotic — tested and reviewed.</p>
    <div class="grid gap-5">
      {articles.map(article => (
        <ArticleCard title={article.data.title} description={article.data.description} href={articleHref(article)} category="tools" date={article.data.date} />
      ))}
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const today = new Date().toISOString().slice(0, 10);
const articles = (await getCollection('articles'))
  .filter(a => a.data.category === 'books' && a.data.date <= today)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function articleHref(article: any) {
  const slug = article.id.split('/').pop()!.replace(/\.md$/, '');
  return `/books/${slug}`;
}
---

<Base title="Best Books for New Managers" description="Curated book recommendations for first-time people managers. Honest reviews, summaries, and rankings.">
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 mb-3" style="font-family: var(--font-serif);">📚 Books</h1>
    <p class="text-lg text-stone-500 mb-10">Curated picks and honest reviews — the books that actually help new managers.</p>
    <div class="grid gap-5">
      {articles.map(article => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          href={articleHref(article)}
          category="books"
          date={article.data.date}
        />
      ))}
    </div>
  </section>
</Base>

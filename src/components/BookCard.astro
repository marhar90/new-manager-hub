---
interface Props {
  title: string;
  author: string;
  take: string;
  asin: string;
  cover?: string;
  pick?: boolean;
}

const { title, author, take, asin, cover, pick = false } = Astro.props;
const affiliateUrl = `https://www.amazon.com/dp/${asin}?tag=newmanagershu-20`;
---

<div class={`flex gap-4 sm:gap-6 p-5 rounded-xl border ${pick ? 'border-brand-300 bg-brand-50 ring-1 ring-brand-200' : 'border-stone-200 bg-white'} my-6`}>
  {cover && (
    <img src={cover} alt={`${title} cover`} class="w-20 sm:w-24 h-auto rounded-md shadow-sm object-cover flex-shrink-0" loading="lazy" />
  )}
  <div class="flex-1 min-w-0">
    {pick && <span class="text-xs font-bold text-brand-600 uppercase tracking-wide">Top Pick</span>}
    <h4 class="font-bold text-stone-900 text-lg leading-snug mt-0.5">{title}</h4>
    <p class="text-sm text-stone-500 mb-2">by {author}</p>
    <p class="text-sm text-stone-600 leading-relaxed mb-3">{take}</p>
    <a href={affiliateUrl} target="_blank" rel="noopener noreferrer"
       class="inline-flex items-center gap-1.5 text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 px-4 py-2 rounded-lg transition-colors">
      View on Amazon
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
    </a>
  </div>
</div>

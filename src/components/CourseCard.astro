---
interface Props {
  title: string;
  platform: string;
  rating?: string;
  price?: string;
  url: string;
  pick?: boolean;
}

const { title, platform, rating, price, url, pick = false } = Astro.props;

const platformColors: Record<string, string> = {
  'Udemy': 'bg-purple-100 text-purple-700',
  'Coursera': 'bg-blue-100 text-blue-700',
  'LinkedIn Learning': 'bg-sky-100 text-sky-700',
};
const badgeClass = platformColors[platform] || 'bg-stone-100 text-stone-700';
---

<div class={`p-5 rounded-xl border ${pick ? 'border-brand-300 bg-brand-50 ring-1 ring-brand-200' : 'border-stone-200 bg-white'} my-6`}>
  <div class="flex items-start justify-between gap-3 mb-2">
    <div>
      {pick && <span class="text-xs font-bold text-brand-600 uppercase tracking-wide">Top Pick</span>}
      <h4 class="font-bold text-stone-900 text-lg leading-snug mt-0.5">{title}</h4>
    </div>
    <span class={`text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap ${badgeClass}`}>{platform}</span>
  </div>
  <div class="flex items-center gap-3 text-sm text-stone-500 mb-3">
    {rating && <span>⭐ {rating}</span>}
    {price && <span>{price}</span>}
  </div>
  <p class="text-sm text-stone-600 leading-relaxed mb-3"><slot /></p>
  <a href={url} target="_blank" rel="noopener noreferrer"
     class="inline-flex items-center gap-1.5 text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 px-4 py-2 rounded-lg transition-colors">
    View Course
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
  </a>
</div>

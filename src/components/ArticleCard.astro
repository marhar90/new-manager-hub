---
interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  date?: string;
  featured?: boolean;
}

const { title, description, href, category, date, featured = false } = Astro.props;
---

<a href={href} class={`group block rounded-xl border border-stone-200 bg-white hover:border-brand-300 hover:shadow-md transition-all ${featured ? 'p-6 sm:p-8' : 'p-5'}`}>
  <span class="text-xs font-semibold text-brand-600 uppercase tracking-wide">{category}</span>
  <h3 class={`font-bold text-stone-900 group-hover:text-brand-700 transition-colors mt-1 mb-2 leading-snug ${featured ? 'text-xl sm:text-2xl' : 'text-lg'}`}
      style="font-family: var(--font-serif);">
    {title}
  </h3>
  <p class="text-sm text-stone-500 leading-relaxed line-clamp-2">{description}</p>
  {date && <p class="text-xs text-stone-400 mt-3">{new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>}
</a>
